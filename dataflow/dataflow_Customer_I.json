{
	"name": "dataflow_Customer_I",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Customer_Part_I",
						"type": "DatasetReference"
					},
					"name": "sourceCustomer",
					"description": "Add Customer source dataset "
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SnowflakeTable5",
						"type": "DatasetReference"
					},
					"name": "sinkCustomer"
				}
			],
			"transformations": [
				{
					"name": "surrogateKeyCustomer"
				},
				{
					"name": "derivedCustomer"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customerid as string,",
				"          CustomerName as string,",
				"          billTo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceCustomer",
				"sourceCustomer keyGenerate(output(RowNum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKeyCustomer",
				"surrogateKeyCustomer derive(DI_CreatedDt = currentDate(),",
				"          pid = \"0\") ~> derivedCustomer",
				"derivedCustomer alterRow(upsertIf(!isNull(customerid))) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CUSTOMER_SK as decimal(38,0),",
				"          CUSTOMER_ID as decimal(38,0),",
				"          CUSTOMER_NAME as string,",
				"          BILLTO as string,",
				"          DI_CREATEDDT as timestamp,",
				"          PID as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     keys:['CUSTOMER_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true,",
				"     mapColumn(",
				"          CUSTOMER_SK = RowNum,",
				"          CUSTOMER_ID = customerid,",
				"          CUSTOMER_NAME = CustomerName,",
				"          BILLTO = billTo,",
				"          DI_CREATEDDT = DI_CreatedDt,",
				"          PID = pid",
				"     )) ~> sinkCustomer"
			]
		}
	}
}